# Copy to .env and fill in. Never commit .env (§24).
# The app works offline without keys (Mock LLM, SQLite, open local API mode).
SIGNALCRAFT_ENV=dev
SIGNALCRAFT_DB_PATH=data/signalcraft.db

# API auth (§24): when set, clients must send X-API-Key. Unset = open local mode.
SIGNALCRAFT_API_KEY=

# CORS (§24): comma-separated browser origins allowed to call the API.
# Local dev default covers Next.js. For Vercel, add your production URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LLM (§21): OpenRouter is the initial live provider. Unset = Mock offline provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHEAP_MODEL=mock
STRONG_MODEL=mock
PRIMARY_MODEL=mock

# Quality (§15): revise while score < threshold, at most MAX_RETRIES passes.
QUALITY_THRESHOLD=7.5
MAX_RETRIES=1

# Scoring weights (§10-§11, JSON overrides).
TREND_WEIGHTS_JSON=
OPP_WEIGHTS_JSON=

# Frontend (§24: no secrets here, public URL only).
NEXT_PUBLIC_API_URL=http://localhost:8001

# Google OAuth (clean boundary): unset = Google button shows setup state, never fake success.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved for the Postgres/pgvector + Redis cutover (docs/database.md).
DATABASE_URL=
REDIS_URL=
